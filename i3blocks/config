# i3blocks configuration file
# see https://vivien.github.io/i3blocks

# global 
markup=pango

# --- (separator)
separator=false
separator_block_width=10
full_text=<span color='#606570'> // </span>


### netfaces ###

[net]
command=./monitor-statscore netfaces.combo  | ./fix-num-fmt
interval=persist

### temps ###
[---]

[temp]
command=./monitor-statscore temps.1 ,,,, | ./fix-num-fmt
interval=persist
[temp-name]
command=~/.scripts/statscored/statscore temps.1.name
interval=5

### bats ###
[---]

[bat]
command=./monitor-statscore bats.combo ,,,, | ./fix-num-fmt 
interval=persist
[remain_time]
label= 
command=~/.scripts/statscored/statscore bats.remain_time | ./fix-num-fmt
interval=15

### system health ###
[---]

[cpu]
command=./monitor-statscore cpu_load  | ./fix-num-fmt
interval=persist

[ram]
command=./monitor-statscore ram  | ./fix-num-fmt
interval=persist
[swap]
command=./monitor-statscore swap  | ./fix-num-fmt
interval=persist

[disk]
command=./monitor-statscore fs."/"  | ./fix-num-fmt
interval=persist

### system bar ###
[---]

[brightness]
label= 
command=echo $(( $(brightnessctl g)*100/$(brightnessctl m) ))%
interval=1

[volume]
command=echo $(pactl get-sink-mute @DEFAULT_SINK@ | grep -q "yes" && echo   || echo ) $(pactl get-sink-volume @DEFAULT_SINK@ | head -n1 | cut -F5 | cut -d% -F1)%
interval=1

[updates]
full_text=
command=function echo-updates { UPDATES=$(cat /tmp/update_checker_count); [ $UPDATES -gt 0 ] && echo " $UPDATES" | ./fix-num-fmt || echo ""; }; echo-updates; exec inotifyd - /tmp/update_checker_count:c | while read -r event; do echo-updates; done
interval=persist

[time]
label= 
command=date '+%d %b  ·  %H:%M' | ./fix-num-fmt
interval=15
