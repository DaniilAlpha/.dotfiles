# i3 config file (v4)
# see https://i3wm.org/docs/userguide.html

#############
### looks ###
#############

font pango:sans-serif bold 8 

set $col-prim	#5294E2
set $col-secn	#606570
set $col-tert	#606570
set $col-back	#383C4A

set $col-onprim	#FFFFFF
set $col-onsecn	#FFFFFF
set $col-onback	#D3DAE3

set $col-warn	#F27835

#name			title border	back and win b	on back		split indi
client.focused		$col-prim	$col-prim	$col-onprim	$col-tert
client.focused_inactive	$col-secn	$col-back	$col-onback	$col-back
client.unfocused	$col-back	$col-back	$col-onback	$col-back
client.urgent		$col-warn	$col-warn	$col-onprim	$col-warn
client.placeholder	$col-back	$col-back	$col-onback	$col-back

smart_borders on
default_border normal 1

title_align center

# fix cursor
exec --no-startup-id xsetroot -cursor_name left_ptr


############
### apps ###
############

set $launcher "rofi -modes combi -combi-modi drun,run -show combi -display-combi launch"
set $power "~/.config/rofi/menus/power"
set $terminal i3-sensible-terminal
set $filemanager pcmanfm

# start XDG autostart .desktop files using dex. 
exec --no-startup-id dex --autostart --environment i3
# screen lock with xss-lock
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
# NetworkManager applet
exec --no-startup-id nm-applet

####################
### window rules ###
####################

exec --no-startup-id sh -c 'while pgrep -u "$USER" -x i3 > /dev/null; do \
    yad --calendar                      \
    --title="popup-calendar"            \
    --no-buttons --undecorated          \
    --close-on-unfocus                  \
    ; done'
for_window [title="popup-calendar"]     \
    floating enable,                    \
    sticky enable,                      \
    border pixel 1,                     \
    resize set 250px 200px,             \
    move position mouse,                \
    move scratchpad


##################
### workspaces ###
##################

set $ws1 "1: 󰆍 Main"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"


#############
### binds ###
#############

set $mod Mod4
set $altmod Mod1

floating_modifier $mod

# move tiling windows via drag & drop by the title bar, or anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

bindsym $mod+x exec $launcher
bindsym $mod+Escape exec $power
bindsym XF86PowerOff exec $power
bindsym $mod+Return exec $terminal
bindsym $mod+backslash exec $filemanager

# kill focused window
bindsym $mod+Shift+q kill

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+s split h
# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+q layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle
# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# focus the parent container
#bindsym $mod+i focus parent
# focus the child container
#bindsym $mod+o focus child

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+r reload
bindsym $mod+Shift+r restart

# brightness
set $notify-brightness notify-send "Brightness" -h int:value:$(( $(brightnessctl g)*100/$(brightnessctl m) )) -u low -i brightness-symbolic 
bindsym $mod+F4 exec --no-startup-id brightnessctl s 10%- && $notify-brightness 
bindsym $mod+F5 exec --no-startup-id brightnessctl s +10% && $notify-brightness
bindsym $mod+F6 exec --no-startup-id brightnessctl s 40% && $notify-brightness "Default"

# screenshot
set $notify-screenshot notify-send "Screenshot" -u low
bindsym $mod+F7 exec --no-startup-id maim > /tmp/.screenshot.png && xclip -selection clipboard -t image/png /tmp/.screenshot.png && $notify-screenshot -i accessories-screenshot-symbolic "Copy screen to clipboard"
bindsym $mod+$altmod+F7 exec --no-startup-id maim -s > /tmp/.screenshot.png && xclip -selection clipboard -t image/png /tmp/.screenshot.png && $notify-screenshot -i accessories-screenshot-symbolic "Copy selected area to clipboard"

# media
set $notify-player notify-send "Player" -u low
bindsym $mod+F10 exec --no-startup-id playerctl position 5- && $notify-player -i media-seek-backward-symbolic "Rewind 5 seconds"
bindsym $mod+$altmod+F10 exec --no-startup-id playerctl previous && $notify-player -i media-skip-backward-symbolic "Previous"
bindsym $mod+F12 exec --no-startup-id playerctl position 5+ && $notify-player -i media-seek-forward-symbolic "Skip 5 seconds"
bindsym $mod+$altmod+F12 exec --no-startup-id playerctl next && $notify-player -i media-skip-forward-symbolic "Next"
bindsym $mod+F11 exec --no-startup-id STATUS=$(playerctl status) && playerctl play-pause &&	\
	echo $STATUS | grep -q Playing								\
		&& $notify-player -i media-playback-pause-symbolic "Pause"			\
		|| $notify-player -i media-playback-start-symbolic "Play"

# volume
set $notify-volume notify-send "Volume" -h int:value:$(pactl get-sink-mute @DEFAULT_SINK@ | grep -q "yes" && echo 1 || pactl get-sink-volume @DEFAULT_SINK@ | head -n1 | cut -F5 | cut -d% -F1) -u low -i audio-volume-medium-symbolic
set $cap-volume ([ $(pactl get-sink-volume @DEFAULT_SINK@ | head -n1 | cut -F5 | cut -d% -f1) -gt 100 ] && pactl set-sink-volume @DEFAULT_SINK@ 100% || true)
bindsym XF86AudioLowerVolume		exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $cap-volume && $notify-volume
bindsym $mod+XF86AudioLowerVolume	exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $cap-volume && $notify-volume
bindsym XF86AudioRaiseVolume		exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $cap-volume && $notify-volume
bindsym $mod+XF86AudioRaiseVolume	exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $cap-volume && $notify-volume
bindsym XF86AudioMute		exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $notify-volume 
bindsym $mod+XF86AudioMute	exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $notify-volume 


###################
### resize mode ###
###################

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+Ctrl+r mode "default"
}
bindsym $mod+Ctrl+r mode "resize"


###########
### bar ###
###########

bar {
    status_command i3unblocks 2> /tmp/i3unblocks_stderr

	font pango:sans-serif bold 8

    separator_symbol " // "

	colors {
		background  $col-back
		statusline  $col-onback
        separator   $col-secn

		#name               border      back        on back
		focused_workspace	$col-prim	$col-prim	$col-onprim
		active_workspace	$col-secn	$col-back	$col-onback
		inactive_workspace	$col-back	$col-back	$col-onback
		urgent_workspace	$col-warn	$col-warn	$col-onprim
		binding_mode		$col-secn	$col-secn	$col-onsecn
	}
}
